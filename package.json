{
  "name": "reelshub-landing",
  "private": true,
  "scripts": {
    "cms:up": "docker compose up -d",
    "cms:down": "docker compose down",
    "cms:bootstrap": "node scripts/bootstrap.mjs && node scripts/public-permissions.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:install": "npm --prefix web install",
