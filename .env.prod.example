# Copy to .env.prod on the server and fill secrets:
#   cp .env.prod.example .env.prod

# Domains / ACME
ACME_EMAIL=admin@reelshub.pro

# Postgres
DB_USER=directus
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_DATABASE=directus

# Directus
DIRECTUS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
ADMIN_EMAIL=admin@reelshub.pro
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DIRECTUS_PUBLIC_URL=https://cms.reelshub.pro
CORS_ORIGIN=https://reelshub.pro,https://www.reelshub.pro

# Next.js (public — baked into client at image build)
NEXT_PUBLIC_DIRECTUS_URL=https://cms.reelshub.pro
NEXT_PUBLIC_SITE_URL=https://reelshub.pro

# Bootstrap from your laptop / server (after stack is up)
DIRECTUS_URL=https://cms.reelshub.pro
DIRECTUS_ADMIN_EMAIL=admin@reelshub.pro
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
